# ==============================================================
# VayuDrishti (वायु दृष्टि) - Environment Configuration
# ==============================================================
# Note: Primary authentic telemetry runs out-of-the-box using 
# Open-Meteo & Copernicus CAMS APIs without requiring any API key!
#
# Optional keys can be added below or via the in-app Settings modal:
#
# 1. Google Gemini Flash API Key (For VayuMitra generative dialogue)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# 2. WAQI (World Air Quality Index) Token (Optional secondary ground stations)
# Get a free instant token at: https://aqicn.org/data-platform/token/
VITE_WAQI_TOKEN=
